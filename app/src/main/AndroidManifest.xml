<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Per sapere se Shizuku è installato e aprirlo. -->
    <!-- "Disinstalla" dal menu delle app della Home: Android chiede sempre conferma. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Centro di controllo: regolare la luminosità. Facoltativo: si concede da una voce chiara del pannello. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Centro di controllo: sapere se il Wi-Fi è acceso (permesso normale, nessuna richiesta; non dà accesso a Internet). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Modalità Gaming: mettere in pausa la sincronizzazione automatica degli account e riprenderla all'uscita (permessi normali, nessuna richiesta). -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Lo sfondo di NOVA anche sulla schermata di blocco (permesso normale, nessuna richiesta). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Scorrere giù sulla Home apre le notifiche. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Facoltativo, lo concede l'utente: serve solo a leggere lo sfondo di sistema per sfocarlo
         dentro NOVA (da Android 13 non c'è un permesso più piccolo). Nessun altro file viene letto. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- La tastiera di NOVA: per sapere se c'è e quale versione ha, e aggiornarla. -->
        <package android:name="it.manlio.nova.keyboard" />
        <!-- Widget di altre app, da mostrare nella Home (AppWidgetHost). -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- «Cerca sul web» dalla ricerca della Home: serve un browser che risponda. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <!-- La Home deve vedere tutte le app avviabili (visibilità dei pacchetti, Android 11+). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Pacchetti di icone di terzi (formato appfilter.xml). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
    </queries>

    <application
        android:name=".NovaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Notifiche sotto le icone e musica nell'isola (SPEC §6.2, §6.7): si attiva solo se l'utente dà l'accesso
             alle notifiche a NOVA dalle impostazioni di Android. Le notifiche restano in memoria. -->
        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:label="@string/notes_title"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density" />
        <!-- Sveglia del Pomodoro: fa ripartire NOVA se Android l'ha chiusa. Non esce dall'app. -->
        <receiver android:name=".PomodoroAlarm" android:exported="false" />

        <service
            android:name=".NovaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Centro di controllo sopra le altre app (SPEC §2.2, §6.8): si attiva solo se l'utente accende il servizio
             nelle impostazioni di accessibilità di Android. Non legge lo schermo: disegna due finestre sue. -->
        <service
            android:name=".NovaControlService"
            android:exported="true"
            android:label="@string/overlay_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        <!-- Home di NOVA (Fase 0, punto 11): Android la propone come app Home predefinita. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Nova.Home"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
