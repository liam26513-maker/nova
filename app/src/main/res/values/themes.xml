<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home: finestra NON traslucida (altrimenti nelle app recenti traspare l'app aperta prima).
         Lo sfondo di sistema si mostra solo se NOVA non lo disegna da sé (vedi HomeWindow). -->
    <style name="Theme.Nova.Home" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
