<?xml version="1.0" encoding="utf-8"?>
<!-- Servizio di NOVA che mostra il centro di controllo sopra le altre app (SPEC §2.2, §6.8).
     Non legge lo schermo (nessun contenuto di finestra): disegna solo finestre sue. Guarda i tasti, senza consumarli, solo per
     volume giù tenuto premuto in Gaming (uscita di emergenza) e volume su (avvio della misura del gioco).
     Ascolta soltanto il cambio di finestra, per chiudere il pannello. Non chiede il pulsante di accessibilità: con quella richiesta
     Android nasconde l'interruttore del servizio e lo lega alla scorciatoia, e sul tablet di riferimento accenderla manda in crash
     le Impostazioni. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/overlay_service_description" />
