<?xml version="1.0" encoding="utf-8"?>
<!-- Servizio di NOVA che mostra il centro di controllo sopra le altre app (SPEC §2.2, §6.8).
     Non legge lo schermo (nessun contenuto di finestra) e non compie azioni: disegna solo due finestre sue.
     Ascolta soltanto il cambio di finestra, per chiudere il pannello e nascondere la striscia sulla Home di NOVA. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/overlay_service_description" />
